{
  // Type-check / editor config. Sources are TypeScript; the repo-root word-bank
  // checker stays a plain .mjs script (no root manifest to run TypeScript) and
  // is typed through scripts/check-word-bank.d.mts.
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": ["node"],
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": ["**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
