# syntax=docker/dockerfile:1

# NOTE: deliberately named Dockerfile.aws, not Dockerfile.
#
# Railway auto-detects a file named `Dockerfile` in the service root and would
# build with it, then run as the unprivileged `node` user. Railway's /data
# volume is root-owned, so the app could read the database but not write it —
# every write endpoint returned 500. Keeping the name different lets Railway
# keep building with Railpack, while AWS uses this file via compose.yaml.

# ─── build stage ───────────────────────────────────────────────────────────
# better-sqlite3 is a native addon, so it is installed here where the build
# tooling lives. Building inside the same Debian/Node 22 base as the runtime
# stage is the whole point: the compiled binary matches the runtime's libc and
# Node ABI. `npm ci` on a Windows host would produce a PE binary that cannot
# load here.
FROM node:22-bookworm-slim AS build

WORKDIR /app

# Only needed if better-sqlite3 has no prebuilt binary for this platform and
# Node ABI. Kept out of the runtime stage so the shipped image stays small.
RUN apt-get update \
  && apt-get install -y --no-install-recommends python3 make g++ \
  && rm -rf /var/lib/apt/lists/*

# Manifests first, so editing source does not re-run the native install.
COPY package.json package-lock.json ./
RUN npm ci --omit=dev

# ─── runtime stage ─────────────────────────────────────────────────────────
FROM node:22-bookworm-slim AS runtime

ENV NODE_ENV=production \
    PORT=8000 \
    DB_PATH=/data/typing_test.db

WORKDIR /app

# /data is the persistent volume mount point (an EBS volume on EC2). This only
# helps when NO volume is mounted: a mount shadows the image's /data entirely,
# so the ownership set here is ignored at runtime. On EC2 the mounted EBS volume
# must be owned by uid 1000 first — `sudo chown -R 1000:1000 /data` — or the app
# can read the database but not write it, and every write request returns 500.
RUN mkdir -p /data && chown node:node /data

COPY --from=build /app/node_modules ./node_modules
COPY . .

# Run as the image's unprivileged user (uid 1000).
USER node

EXPOSE 8000

# The app exposes no /health route, but GET / returns 200 JSON. Bound to
# loopback so the check never touches a public interface.
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:'+(process.env.PORT||8000)+'/').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"

# index.js is the entrypoint; `npm start` runs the same command.
CMD ["node", "index.js"]
