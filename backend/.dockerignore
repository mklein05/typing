# Docker does NOT read .gitignore. Without this file, `COPY . .` in the
# Dockerfile would bake backend/.env (Supabase service-role key, OpenRouter key)
# and typing_test.db (real user keystrokes) into an image layer — and then into
# every registry that image is ever pushed to.

node_modules
npm-debug.log*

# Stale local build output; the image compiles its own.
dist

# Secrets. .env.example is the empty template and is safe to include.
.env
.env.*
!.env.example

# Local database, its WAL sidecars, and restore.js scratch files. All of these
# hold real user data.
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
*.db.incoming
*.db.pre-restore-*

# Not needed at runtime.
.git
.gitignore
test
*.md

# Deployment artifacts are not part of the application.
Dockerfile
.dockerignore
compose.yaml
