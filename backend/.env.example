# Copy to .env and fill in. Never commit real secrets.

PORT=8000

# Supabase — used server-side to verify access tokens.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# Comma-separated. Must include the deployed frontend URL or CORS blocks every request.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Optional. Where the SQLite file lives. On Railway use a volume: /data/typing_test.db
# DB_PATH=./typing_test.db

# Optional: off-site backups (see README). Backups stay off until the service role key
# is set. That key bypasses row-level security, so it is server-side only and must never
# be exposed to the browser. The bucket must be PRIVATE — it holds the whole database.
# SUPABASE_SERVICE_ROLE_KEY=
# BACKUP_BUCKET=db-backups
# BACKUP_RETENTION_DAYS=14
# BACKUP_INTERVAL_HOURS=24

# Optional: only needed to trigger a backup over HTTP. Leave unset and the
# /api/admin/backup route rejects everything with a 401.
# BACKUP_SECRET=

# Optional: free-tier daily allowance for metered premium features (UTC day).
# FREE_LLM_DAILY_LIMIT=3

# LLM practice. OPENROUTER_API_KEY enables the feature; while LLM_MODEL is unset
# the route reports the feature as unavailable rather than guess a model. Slugs
# look like "vendor/model" — browse them at openrouter.ai/models.
#
# Avoid reasoning models. They bill their "thinking" as completion tokens, which
# on a short constrained-writing task is many times the length of the passage
# itself. Measured on a 35-word passage (2026-09-16):
#   meta-llama/llama-3.1-8b-instruct   ~2.0s   $0.000005   clean first try
#   google/gemma-3-4b-it               ~2.1s   $0.000012   needed the retry
#   mistralai/mistral-nemo             ~3.6s   failed     ignored the length
#   deepseek/deepseek-v4.1-flash       ~5.9s   failed     512 tokens reasoning, no output
# OPENROUTER_API_KEY=
# LLM_MODEL=google/gemini-3.1-flash-lite
# LLM_TIMEOUT_MS=8000
# LLM_MAX_TOKENS=512
# LLM_MIN_FUNCTION_RATIO=0.2
