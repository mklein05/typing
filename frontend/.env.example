# Copy to .env and fill in. Never commit real secrets.

# Supabase — used in the browser for auth.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Backend API base. Leave unset locally so the http://localhost:8000 fallback
# applies. Vite inlines VITE_* at build time, so changing this requires a
# rebuild, not just a restart.
# VITE_API_URL=https://your-backend.example.com
